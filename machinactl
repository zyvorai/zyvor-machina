# ── Main ────────────────────────────────────────────────────────────────
main() {
    ORIGINAL_ARGS=("$@")
    local lead_fleet=0
    if [[ "${1:-}" == --fleet ]]; then
        lead_fleet=1
        shift
    fi
    local cmd="${1:-help}"
    shift || true
    if [[ $lead_fleet == 1 ]]; then
        case "$cmd" in
            netpol|networkpolicy|cnp|flow|flows|hubble|vm) set -- "$@" --fleet ;;
            *) err "--fleet applies to netpol, flow and vm"; exit 1 ;;
        esac
    fi

    case "$cmd" in
        deps)       cmd_deps "$@" ;;
        build)      cmd_build "$@" ;;
        test)       cmd_test "$@" ;;
        install)    cmd_install "$@" ;;
        uninstall)  cmd_uninstall "$@" ;;
        deploy)     cmd_deploy "$@" ;;
        reinstall)  cmd_reinstall "$@" ;;
        upgrade)    cmd_upgrade "$@" ;;
        backup)     cmd_backup "$@" ;;
        restore)    cmd_restore_all "$@" ;;
        verify)     cmd_verify "$@" ;;
        health)     cmd_health "$@" ;;
        start)      cmd_start "$@" ;;
        stop)       cmd_stop "$@" ;;
        restart)    cmd_restart "$@" ;;
        status)     cmd_status "$@" ;;
        logs)       cmd_logs "$@" ;;
        doctor)     cmd_doctor "$@" ;;
        preflight)  cmd_preflight "$@" ;;
        dist)       cmd_dist "$@" ;;
        host|hosts) cmd_host "$@" ;;
        show-login|login) cmd_show_login "$@" ;;
        db)         cmd_db "$@" ;;
        tls)        cmd_tls "$@" ;;
        demo)       cmd_demo "$@" ;;
        audit)
            sub="${1:-}"
            shift || true
            case "$sub" in
                verify) cmd_audit_verify "$@" ;;
                *) err "Usage: machinactl audit verify [max_lines]"; exit 1 ;;
            esac
            ;;
        integrations) cmd_integrations "$@" ;;
        sprite)     cmd_sprite "$@" ;;
        netpol|networkpolicy|cnp) np_run np_netpol_main "$@" ;;
        metal|baremetal) np_run metal_main "$@" --fleet ;;
        flow|flows|hubble) np_run np_flow_main "$@" ;;
        vm)         cmd_vm "$@" ;;
        help|--help|-h) cmd_help ;;
        *)
            err "Unknown command: $cmd"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
