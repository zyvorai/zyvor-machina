# ── doctor ──────────────────────────────────────────────────────────────
cmd_doctor() {
    step "System Readiness Check"
    local issues=0

    local distro
    distro=$(detect_distro)
    info "Distribution: $distro"

    # systemd version
    local sd_ver
    sd_ver=$(systemctl --version 2>/dev/null | head -1 | awk '{print $2}') || sd_ver="unknown"
    ok "systemd $sd_ver"

    # KVM
    if [[ -e /dev/kvm ]]; then ok "KVM available"; else warn "KVM not available"; ((issues++)) || true; fi

    # Required commands
    for cmd in virsh virt-install qemu-img curl jq; do
        if command -v "$cmd" &>/dev/null; then
            ok "$cmd found"
        else
            err "$cmd not found"; ((issues++)) || true
        fi
    done

    # Optional
    for cmd in rsync socat virt-viewer; do
        if command -v "$cmd" &>/dev/null; then
            ok "$cmd found (optional)"
        else
            warn "$cmd not found (optional)"
        fi
    done

    # Rust (only needed to build from source; a package install has no use for it)
    if command -v cargo &>/dev/null; then
        ok "Rust $(rustc --version | awk '{print $2}')"
    elif command -v machina-daemon &>/dev/null; then
        info "Rust toolchain not installed (not needed: Machina is installed from packages)"
    else
        err "Rust toolchain not installed (needed to build from source)"; ((issues++)) || true
    fi

    # libvirtd
    if systemctl is-active --quiet libvirtd 2>/dev/null; then
        ok "libvirtd is running"
    else
        warn "libvirtd is not running"
    fi

    # machina
    if command -v machina-daemon &>/dev/null; then
        ok "machina-daemon is installed"
    else
        warn "machina-daemon not yet installed"
    fi

    if systemctl is-active --quiet machina-daemon 2>/dev/null; then
        ok "machina-daemon is running"
    else
        warn "machina-daemon is not running"
    fi

    echo ""
    if [[ $issues -eq 0 ]]; then
        ok "System is ready"
    else
        warn "$issues issue(s) found — run ./machinactl deps to fix"
    fi
}

