# ── controller API helpers (root: reads the admin password from /etc/default/machina-platform) ──
_ctl_url() { echo "${MACHINA_CONTROLLER_URL:-http://127.0.0.1:5093}"; }
_ctl_token() {
    local env=/etc/default/machina-platform user pw
    [[ -r $env ]] || { err "cannot read $env (run as root on the controller)"; exit 1; }
    user="$(sed -n 's/^MACHINA_ADMIN_USER=//p' "$env" | head -1)"; user="${user:-admin}"
    pw="$(sed -n 's/^MACHINA_ADMIN_PASSWORD=//p' "$env" | head -1)"
    curl -fsS -m 15 -X POST "$(_ctl_url)/api/v1/auth/login" -H 'content-type: application/json' \
        -d "{\"username\":\"$user\",\"password\":\"$pw\"}" | python3 -c 'import sys,json; print(json.load(sys.stdin)["token"])'
}
_ctl() { # METHOD PATH [JSON]
    local m="$1" path="$2" body="${3:-}" tok
    tok="$(_ctl_token)" || exit 1
    if [[ -n $body ]]; then
        curl -fsS -m 60 -X "$m" "$(_ctl_url)$path" -H "authorization: Bearer $tok" -H 'content-type: application/json' -d "$body"
    else
        curl -fsS -m 60 -X "$m" "$(_ctl_url)$path" -H "authorization: Bearer $tok"
    fi
}
_host_id() { # NAME -> id
    _ctl GET /api/v1/hosts | python3 -c '
import sys, json
n = sys.argv[1]
for h in json.load(sys.stdin):
    if h["hostname"] == n or h["address"] == n:
        print(h["id"]); break' "$1"
}

# ── dist: publish the agent so a bare node can install itself from this controller ──
cmd_dist() {
    local sub="${1:-}"; shift || true
    case "$sub" in
        publish)
            need_root
            local dest="${MACHINA_DIST_DIR:-/var/lib/machina/dist}" f src
            mkdir -p "$dest"
            for f in machina-agent machina-bpfd; do
                src="$(command -v "$f" || true)"; [[ -n $src ]] || src="$SCRIPT_DIR/target/release/$f"
                [[ -x $src ]] || { err "$f not found (install the agent package or build it)"; exit 1; }
                install -m 0755 "$src" "$dest/$f"
            done
            for f in machina-agent.service machina-bpfd.service; do
                src=""
                for d in /etc/systemd/system /usr/lib/systemd/system "$SCRIPT_DIR/contrib"; do [[ -f $d/$f ]] && { src="$d/$f"; break; }; done
                [[ -n $src ]] || { err "$f not found"; exit 1; }
                install -m 0644 "$src" "$dest/$f"
            done
            (cd "$dest" && sha256sum machina-agent machina-bpfd machina-agent.service machina-bpfd.service > SHA256SUMS)
            ok "published to $dest (served at /dist/ by the controller)"
            ( cd "$dest" && cat SHA256SUMS )
            ;;
        status)
            local dest="${MACHINA_DIST_DIR:-/var/lib/machina/dist}"
            if [[ -f $dest/SHA256SUMS ]]; then ok "published in $dest"; cat "$dest/SHA256SUMS"; else warn "nothing published: run  sudo machinactl dist publish"; fi
            ;;
        *) err "Usage: machinactl dist publish|status"; exit 1 ;;
    esac
}

# ── host: add / list / drain / remove nodes ──
cmd_host() {
    local sub="${1:-}"; shift || true
    case "$sub" in
        list|ls)
            _ctl GET /api/v1/hosts | python3 -c '
import sys, json
rows = json.load(sys.stdin)
print("%-26s %-16s %-10s %-5s %-6s %-9s %s" % ("NAME", "ADDRESS", "STATE", "VMS", "CPU%", "AGENT", "VALIDATION"))
for h in rows:
    print("%-26s %-16s %-10s %-5s %-6s %-9s %s" % (h["hostname"][:26], h["address"][:16], h["state"], h["vm_count"], round(h["cpu_percent"] or 0), (h.get("agent_version") or "?")[:9], h["validation_status"]))'
            ;;
        add)
            local target="${1:-}"
            [[ -n $target ]] || { err "Usage: machinactl host add USER@HOST   (needs SSH access and sudo on the new node)"; exit 1; }
            local resp cmd tok
            resp="$(_ctl POST /api/v1/enrollment/tokens '{"ttl_hours":1}')" || exit 1
            cmd="$(printf %s "$resp" | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get("join_command") or d["install_command"])')"
            tok="$(printf %s "$resp" | python3 -c 'import sys,json; print(json.load(sys.stdin)["token"])')"
            step "Adding $target to the fleet"
            info "running the join command on $target (the token is single use and expires in 1 hour)"
            if ssh -t -o StrictHostKeyChecking=accept-new "$target" "$cmd"; then
                ok "$target ran the join command; give it a few seconds, then:  machinactl host list"
                info "or watch it join live in the web UI: Platform > Hosts"
            else
                err "the command failed on $target; revoking its token"
                _ctl DELETE "/api/v1/enrollment/tokens/$tok" >/dev/null 2>&1 || true
                exit 1
            fi
            ;;
        drain)
            local id; id="$(_host_id "${1:-}")"; [[ -n $id ]] || { err "no such host: ${1:-}"; exit 1; }
            _ctl POST "/api/v1/hosts/$id/maintenance" '{"action":"enter","evacuate":true}' >/dev/null && ok "${1} is draining: VMs are being moved off it"
            ;;
        undrain)
            local id; id="$(_host_id "${1:-}")"; [[ -n $id ]] || { err "no such host: ${1:-}"; exit 1; }
            _ctl POST "/api/v1/hosts/$id/maintenance" '{"action":"exit","evacuate":false}' >/dev/null && ok "${1} is schedulable again"
            ;;
        remove|rm)
            local id; id="$(_host_id "${1:-}")"; [[ -n $id ]] || { err "no such host: ${1:-}"; exit 1; }
            _ctl DELETE "/api/v1/hosts/$id" >/dev/null && ok "${1} removed from the fleet (its agent token and certificate are no longer accepted)"
            ;;
        *) err "Usage: machinactl host list|add USER@HOST|drain NAME|undrain NAME|remove NAME"; exit 1 ;;
    esac
}

# ── show-login ──────────────────────────────────────────────────────────
# Where to sign in and with what, for a first-run install (the generated admin password is root-only).
cmd_show_login() {
    local file=/etc/machina/INITIAL_ADMIN_PASSWORD env=/etc/default/machina-platform user=admin pw="" host
    if [[ $EUID -ne 0 ]]; then
        err "run as root: sudo machinactl show-login (the password file is readable by root only)"; exit 1
    fi
    if [[ -r $file ]]; then
        user="$(sed -n 's/^username: *//p' "$file" | head -1)"; user="${user:-admin}"
        pw="$(sed -n 's/^password: *//p' "$file" | head -1)"
    fi
    [[ -z $pw && -r $env ]] && pw="$(sed -n 's/^MACHINA_ADMIN_PASSWORD=//p' "$env" | head -1)"
    host="$(hostname -I 2>/dev/null | awk '{print $1}')"; host="${host:-$(hostname -f 2>/dev/null || hostname)}"
    echo ""
    echo "  Sign in:   https://${host}:5092   (the certificate is self-signed until you install your own: machinactl tls)"
    if [[ -n $pw ]]; then
        echo "  Username:  $user"
        echo "  Password:  $pw"
        echo ""
        warn "Change the password after your first sign-in."
    else
        echo "  No generated admin password found: sign in with a local (PAM) Linux account."
    fi
    echo ""
}

# ── tls ─────────────────────────────────────────────────────────────────
cmd_tls() {
    need_root
    step "TLS Certificate Setup"

    local cert_dir="/etc/machina/ssl"
    local cert_file="$cert_dir/cert.pem"
    local key_file="$cert_dir/key.pem"

    mkdir -p "$cert_dir"

    if [[ -f "$cert_file" && -f "$key_file" ]]; then
        local expiry
        expiry=$(openssl x509 -enddate -noout -in "$cert_file" 2>/dev/null | cut -d= -f2)
        ok "Certificate already exists (expires: $expiry)"
        read -rp "Regenerate? [y/N] " answer
        [[ "$answer" != "y" && "$answer" != "Y" ]] && return
    fi

    local hostname
    hostname=$(hostname -f 2>/dev/null || hostname)

    info "Generating self-signed certificate for $hostname..."
    # umask 077 so key_file is created non-world-readable from the first byte openssl
    # writes — no window where the private key sits world-readable before the chmod below.
    (umask 077 && openssl req -x509 -newkey rsa:4096 \
        -keyout "$key_file" -out "$cert_file" \
        -sha256 -days 365 -nodes \
        -subj "/CN=$hostname/O=machina" \
        -addext "subjectAltName=DNS:$hostname,DNS:localhost,IP:127.0.0.1" \
        2>/dev/null)

    chmod 600 "$key_file"
    chmod 644 "$cert_file"

    ok "Certificate generated"
    info "Cert: $cert_file"
    info "Key:  $key_file"
}

